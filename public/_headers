# Cloudflare Pages caching. Files under /_next/static/ have a content hash in their name, so they never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Media keeps its name across deploys: cache a week, then recheck.
/*.mp4
  Cache-Control: public, max-age=604800
/*.webm
  Cache-Control: public, max-age=604800
/*.avif
  Cache-Control: public, max-age=604800
