---
import ContactList from "../../components/ContactList.astro";
import PageShell from "../../components/PageShell.astro";
import { KICKER } from "../../components/styles";
import { localeStaticPaths, type Locale } from "../../i18n/routing";
import { getT } from "../../i18n/t";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.locale as Locale;
const all = getT(locale);
const t = getT(locale, "tcs");
const [lead, ...rest] = t.raw("content") as string[];
// Paragraphs may hold several blocks separated by "\n"; each becomes its own paragraph.
const paragraphs = rest.flatMap((p) => p.split("\n"));
---

<Base locale={locale} path="/terms-conditions" title={t("title")} description={lead}>
	<PageShell>
		<header class="relative border-b-2 border-accent/40 px-5 py-12 sm:px-10 sm:py-14 md:px-14 md:py-16 lg:px-20">
			<div class="mx-auto grid w-full max-w-[90rem] grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
				<div class="space-y-6">
					<p class={KICKER}>{all("links.terms")}</p>
					<h1 class="text-[clamp(1.9rem,4.5vw,2.9rem)] font-light leading-[1.1] tracking-[-0.025em]">{t("title")}</h1>
				</div>
				<p class="text-base font-light leading-[1.75] text-neutral-700 sm:text-lg">{lead}</p>
			</div>
		</header>

		<div class="relative mx-auto grid w-full max-w-[90rem] grid-cols-1 gap-10 px-5 py-14 sm:px-8 sm:py-16 md:px-12 md:py-20 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:gap-12 lg:px-16">
			<div class="divide-y divide-neutral-900/[0.08] rounded-2xl border-2 border-neutral-900/[0.08] bg-surface shadow-[0_24px_64px_-36px_oklch(0.32_0.1_158_/_0.4)]">
				{paragraphs.map((p) => <p class="px-7 py-8 text-base leading-[1.85] text-neutral-700 sm:px-10 sm:text-lg">{p}</p>)}
			</div>

			<aside aria-labelledby="privacy-contact" class="relative self-start overflow-hidden rounded-2xl bg-panel dark:ring-1 dark:ring-accent/30 px-7 py-10 text-zinc-200 sm:px-9">
				<div
					class="pointer-events-none absolute inset-0"
					aria-hidden="true"
					style="background: radial-gradient(ellipse 100% 80% at 100% 0%, var(--panel-glow), transparent 55%)"
				>
				</div>
				<div class="relative">
					<h2 id="privacy-contact" class="mb-8 text-[clamp(1.35rem,2.4vw,1.75rem)] leading-tight tracking-[-0.02em] text-white">
						{all("services.contactTitle")}
					</h2>
					<ContactList locale={locale} dark class="space-y-4" />
				</div>
			</aside>
		</div>
	</PageShell>
</Base>
