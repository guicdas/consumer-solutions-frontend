---
import Button from "../../components/Button.astro";
import CTA from "../../components/CTA.astro";
import JsonLd from "../../components/JsonLd.astro";
import LinkTile from "../../components/LinkTile.astro";
import { KICKER_BASE } from "../../components/styles";
import { localeStaticPaths, type Locale } from "../../i18n/routing";
import { getT, localHref } from "../../i18n/t";
import Base from "../../layouts/Base.astro";
import { REGISTRATION_NO, SITE_URL } from "../../site";

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.locale as Locale;
const t = getT(locale);
const VIDEO_MEDIA = "(min-width: 768px) and (prefers-reduced-motion: no-preference)";
const tiles = [
	{ href: localHref(locale, "/services"), name: t("links.services"), desc: t("services.heroTitle") },
	{ href: localHref(locale, "/certifications"), name: t("links.certifications"), desc: t("certifications.title") },
];
---

<Base locale={locale} path="" title={`${t("home.metaTitle")} · ${t("meta.title")}`} brand={false} description={t("home.metaDescription")}>
	<!-- The poster is the first thing painted on the homepage, so fetch it before the CSS and fonts. -->
	<link slot="head" rel="preload" href="/house-poster.avif" as="image" fetchpriority="high" />

	<main class="relative isolate w-full overflow-hidden bg-page text-neutral-950">
		<!-- shortcut: street address is repeated here in structured form; update it with services.address in messages/*.json. -->
		<JsonLd
			data={{
				"@type": "FinancialService",
				"@id": `${SITE_URL}/#business`,
				name: "Consumer Solutions",
				legalName: "CPCDS Consumer Solutions — Unipessoal, Lda",
				description: t("home.metaDescription"),
				url: `${SITE_URL}/${locale}`,
				logo: `${SITE_URL}/csol.png`,
				image: `${SITE_URL}/csol.png`,
				telephone: t("services.phone").replace(/\s/g, ""),
				email: t("services.email"),
				address: {
					"@type": "PostalAddress",
					streetAddress: "Av. Elias Garcia, 144, 3.º Esq.",
					postalCode: "1050-101",
					addressLocality: "Lisboa",
					addressCountry: "PT",
				},
				areaServed: { "@type": "Country", name: "Portugal" },
				knowsLanguage: ["en", "fr", "pt"],
				identifier: { "@type": "PropertyValue", propertyID: "Banco de Portugal credit intermediary registration", value: REGISTRATION_NO },
				sameAs: ["https://x.com/CONSUMSOLUTION", "https://www.linkedin.com/company/cpcdsconsumersolutions"],
			}}
		/>

		<!-- Video hero -->
		<section class="relative flex min-h-[38rem] items-end h-[92vh]">
			<!-- Sources only match on wider screens with motion allowed; phones and reduced-motion get the poster and download no video. -->
			<video poster="/house-poster.avif" class="absolute inset-0 h-full w-full object-cover" playsinline muted autoplay loop>
				<source src="/house.webm" type="video/webm; codecs=av01.0.08M.10" media={VIDEO_MEDIA} />
				<source src="/house.mp4" type="video/mp4" media={VIDEO_MEDIA} />
				{t("home.videoError")}
			</video>
			<div
				class="absolute inset-0"
				aria-hidden="true"
				style="background: linear-gradient(to top, oklch(0.14 0.032 158 / 0.92) 0%, oklch(0.14 0.032 158 / 0.55) 45%, transparent 80%)"
			>
			</div>
			<div class="relative mx-auto w-full max-w-[90rem] px-5 pb-14 sm:px-10 sm:pb-20 md:px-14 lg:px-20">
				<div class="max-w-[48rem] space-y-6">
					<p class={`${KICKER_BASE} border-[oklch(0.88_0.04_150)] text-[oklch(0.88_0.04_150)]`}>{t("meta.title")}</p>
					<h1 class="text-[clamp(2.5rem,7vw,4.75rem)] font-normal leading-[0.96] tracking-[-0.038em] text-white">
						{t("home.title")}
					</h1>
					<p class="text-lg font-extralight leading-[1.5] text-zinc-200 sm:text-2xl">{t("home.subtitle")}</p>
					<div class="pt-4">
						<a href={localHref(locale, "/services")}>
							<Button str={t("home.services-button")} type={1} class="px-6 py-3 text-lg" />
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Explore -->
		<div
			class="pointer-events-none absolute -left-[25%] top-[60%] h-[60%] w-[90%] rotate-[10deg]"
			aria-hidden="true"
			style="background: linear-gradient(145deg, var(--glow) 0%, transparent 58%)"
		>
		</div>
		<section aria-labelledby="explore-heading" class="relative mx-auto w-full max-w-[90rem] px-5 py-16 sm:px-8 md:px-12 md:py-24 lg:px-16">
			<h2 id="explore-heading" class="mb-10 max-w-[40ch] text-[clamp(1.65rem,3.5vw,2.35rem)] leading-tight tracking-[-0.025em]">
				{t("home.text")}
			</h2>
			<ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:gap-6">
				{
					tiles.map((tile) => (
						<li>
							<LinkTile {...tile} />
						</li>
					))
				}
			</ul>
		</section>

		<CTA locale={locale} />
	</main>
</Base>
