---
import "@fontsource-variable/oswald";
import "../styles/globals.css";
import ThemeScript from "../components/ThemeScript.astro";

// Cloudflare Pages serves this (dist/404.html) for any unknown URL. It sits outside [locale], so it shows all three languages.
const LANGS = [
	{ href: "/en", title: "Page not found", link: "Go to the homepage" },
	{ href: "/fr", title: "Page introuvable", link: "Aller à l'accueil" },
	{ href: "/pt", title: "Página não encontrada", link: "Ir para a página inicial" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>404 · Consumer Solutions</title>
		<link rel="icon" href="/favicon.ico" />
		<ThemeScript />
	</head>
	<body>
		<main class="flex min-h-screen items-center justify-center bg-page px-5 py-16 text-neutral-950">
			<div class="w-full max-w-xl">
				<p class="mb-6 text-[clamp(4rem,14vw,7rem)] font-extralight leading-none tracking-[-0.04em] text-accent">404</p>
				<ul class="divide-y divide-neutral-900/[0.08] rounded-2xl border-2 border-neutral-900/[0.08] bg-surface">
					{
						LANGS.map((l) => (
							<li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-6 py-5">
								<span class="text-xl tracking-[-0.01em]">{l.title}</span>
								<a href={l.href} class="text-sm text-accent underline decoration-accent/35 underline-offset-[0.22em] hover:decoration-accent">
									{l.link}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</main>
	</body>
</html>
