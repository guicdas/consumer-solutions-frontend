---
import type { Locale } from "../i18n/routing";
import { getT } from "../i18n/t";
import Button from "./Button.astro";
import Panel from "./Panel.astro";

interface Props {
	locale: Locale;
}
const t = getT(Astro.props.locale);
---

<section aria-labelledby="cta-heading" class="relative mx-auto w-full max-w-[90rem] px-5 pb-16 sm:px-8 md:px-12 md:pb-24 lg:px-16">
	<Panel as="div" class="px-7 py-12 text-zinc-200 sm:px-10 sm:py-14">
		<div class="relative grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-16">
			<h2 id="cta-heading" class="max-w-[30ch] text-[clamp(1.75rem,3.8vw,2.65rem)] leading-tight tracking-[-0.03em] text-white">
				{t("cta.title")}
			</h2>
			<a href={`mailto:${t("services.email")}?subject=${encodeURIComponent(t("footer.mailSubject"))}`} class="justify-self-start">
				<Button str={t("cta.button")} type={1} class="px-8 py-3 text-lg" />
			</a>
		</div>
		<div class="relative mt-10 border-t border-zinc-600/50 pt-8">
			<h3 class="mb-3 text-sm font-bold uppercase tracking-[0.28em] text-[oklch(0.88_0.04_150)]">
				{t("cta.complianceTitle").replace(/\s*:$/, "")}
			</h3>
			<p class="max-w-[90ch] text-base font-light leading-[1.8] text-zinc-300">{t("cta.complianceBody")}</p>
		</div>
	</Panel>
</section>
