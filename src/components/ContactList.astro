---
import type { Locale } from "../i18n/routing";
import { getT } from "../i18n/t";
import { LINK_DARK, LINK_MUTED } from "./styles";

// Address, phone and email of the firm; `dark` styles it for the dark green panels, `class` sets the layout.
interface Props {
	locale: Locale;
	dark?: boolean;
	class?: string;
}
const { locale, dark = false, class: layout = "" } = Astro.props;
const t = getT(locale, "services");
const link = dark ? LINK_DARK : LINK_MUTED;
const icon = `flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${dark ? "bg-white/10 text-[oklch(0.88_0.04_150)]" : "bg-tint text-accent"}`;
const rows = [
	{ d: "M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z", text: t("address") },
	{ d: "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z", text: t("phone"), href: `tel:${t("phone").replace(/\s/g, "")}` },
	{ d: "M3 6h18v12H3zM3 6l9 7 9-7", text: t("email"), href: `mailto:${t("email")}`, extra: "break-all" },
];
---

<address class={`not-italic ${layout}`}>
	{
		rows.map((r) => (
			<div class="flex items-center gap-4">
				<span class={icon} aria-hidden="true">
					<svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
						<path d={r.d} />
					</svg>
				</span>
				{r.href ? (
					<a class={`${link} ${r.extra ?? ""}`} href={r.href}>
						{r.text}
					</a>
				) : (
					<span class={`leading-relaxed ${dark ? "text-zinc-300" : "text-neutral-700"}`}>{r.text}</span>
				)}
			</div>
		))
	}
</address>
