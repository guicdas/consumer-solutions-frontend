---
// Native <details>; the shared name makes it an exclusive accordion (one open at a time) with no JS.
// Open/close animation lives in globals.css (.faq::details-content).
export type FaqItem = { title: string; body: string };
interface Props {
	title: string;
	items: FaqItem[];
}
const { title, items } = Astro.props;
---

<section aria-labelledby="faq-heading" class="relative mx-auto w-full max-w-[90rem] px-5 pb-16 sm:px-8 sm:pb-20 md:px-12 md:pb-24 lg:px-16">
	<div class="grid grid-cols-1 gap-10 border-t border-neutral-900/[0.08] pt-14 lg:grid-cols-[minmax(0,0.6fr)_minmax(0,1.4fr)] lg:gap-16 md:pt-20">
		<h2 id="faq-heading" class="text-[clamp(1.65rem,3.5vw,2.35rem)] leading-tight tracking-[-0.025em] lg:sticky lg:top-8 lg:self-start">
			{title}
		</h2>
		<div class="overflow-hidden rounded-2xl border-2 border-neutral-900/[0.08] bg-surface shadow-[0_24px_64px_-36px_oklch(0.32_0.1_158_/_0.4)]">
			{
				items.map((item) => (
					<details name="faq" class="faq group border-b border-neutral-900/[0.08] last:border-b-0">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-base font-medium leading-snug text-neutral-900 transition hover:bg-tint focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent sm:px-8 sm:py-6 sm:text-lg [&::-webkit-details-marker]:hidden">
							{item.title}
							<span
								class="h-2 w-2 shrink-0 -translate-y-0.5 rotate-45 border-b-2 border-r-2 border-accent transition-transform duration-200 group-open:translate-y-0.5 group-open:-rotate-[135deg]"
								aria-hidden="true"
							/>
						</summary>
						<p class="px-6 pb-6 text-base leading-[1.8] text-neutral-700 sm:px-8 sm:pb-8">{item.body}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
