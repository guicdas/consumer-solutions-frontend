---
// Light content card with the green top stripe used across the info pages.
interface Props {
	id: string;
	title: string;
	class?: string;
}
const { id, title, class: extra = "" } = Astro.props;
---

<section
	aria-labelledby={id}
	class={`relative overflow-hidden rounded-2xl border-2 border-neutral-900/[0.08] bg-surface p-7 shadow-[0_24px_64px_-36px_oklch(0.32_0.1_158_/_0.4)] sm:p-10 ${extra}`}
>
	<div class="pointer-events-none absolute inset-x-0 top-0 h-1.5 bg-accent-strong" aria-hidden="true"></div>
	<div class="pointer-events-none absolute left-3 top-4 h-6 w-6 rounded-tl-lg border-l-2 border-t-2 border-accent/45" aria-hidden="true"></div>
	<h2 id={id} class="mb-6 text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight tracking-[-0.02em] text-neutral-950">
		{title}
	</h2>
	<slot />
</section>
